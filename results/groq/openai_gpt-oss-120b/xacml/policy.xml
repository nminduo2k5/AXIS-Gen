<Policy xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17" PolicyId="ICS-WaterTreatment-ABAC-v1" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Target/>
  <Rule RuleId="R1_operator_read" Effect="Permit">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>operator</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="ics:subject:role"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>read</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="ics:action:id"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: resource.zone in {'level1_control', 'level2_supervisory'} -->
    </Condition>
  </Rule>
  <Rule RuleId="R2_engineer_readwrite" Effect="Permit">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>engineer</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="ics:subject:role"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>{'write', 'read'}</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="ics:action:id"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: (resource.zone in {'level0_field', 'level1_control', 'level2_supervisory'} AND environment.plant_mode neq 'emergency') -->
    </Condition>
  </Rule>
  <Rule RuleId="R3_deny_override_when_normal" Effect="Deny">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>override_interlock</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="ics:action:id"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>safety</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="ics:resource:criticality"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: environment.safety_state eq 'normal' -->
    </Condition>
  </Rule>
  <Rule RuleId="R4_permit_engineer_override" Effect="Permit">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>engineer</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="ics:subject:role"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>override_interlock</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="ics:action:id"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>safety</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="ics:resource:criticality"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: (environment.safety_state eq 'maintenance' AND subject.clearance_level gte 4 AND subject.location eq 'onsite') -->
    </Condition>
  </Rule>
  <Rule RuleId="R5_deny_vendor_field" Effect="Deny">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>vendor</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="ics:subject:role"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: resource.zone eq 'level0_field' -->
    </Condition>
  </Rule>
  <Rule RuleId="R6_permit_vendor_historian_read" Effect="Permit">
    <Target>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>vendor</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject" AttributeId="ics:subject:role"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>read</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" AttributeId="ics:action:id"/>
        </Match>
      </AllOf>
      <AllOf>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue>historian</AttributeValue>
          <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource" AttributeId="ics:resource:type"/>
        </Match>
      </AllOf>
    </Target>
    <Condition>
      <!-- condition: environment.plant_mode eq 'production' -->
    </Condition>
  </Rule>
</Policy>
